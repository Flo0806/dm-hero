{
  "name": "dm-hero-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DM Hero Monorepo - Campaign management tool for Dungeon Masters",
  "scripts": {
    "dev": "pnpm --filter @dm-hero/app dev",
    "dev:staging": "pnpm --filter @dm-hero/staging dev",
    "dev:landing": "pnpm --filter @dm-hero/landing dev",
    "dev:electron": "pnpm --filter @dm-hero/app dev:electron",
    "build": "pnpm --filter @dm-hero/app build",
    "build:landing": "pnpm --filter @dm-hero/landing build",
    "build:staging": "pnpm --filter @dm-hero/staging build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @dm-hero/app test",
    "typecheck": "pnpm --filter @dm-hero/app typecheck",
    "db:reset": "pnpm --filter @dm-hero/app db:reset",
    "electron:build": "pnpm --filter @dm-hero/app electron:build",
    "electron:build:win": "pnpm --filter @dm-hero/app electron:build:win",
    "electron:rebuild": "pnpm --filter @dm-hero/app electron:rebuild",
    "electron:start": "pnpm --filter @dm-hero/app electron:start",
    "mode:web": "pnpm --filter @dm-hero/app mode:web",
    "mode:electron": "pnpm --filter @dm-hero/app mode:electron",
    "version:bump": "node scripts/version-bump.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.0",
  "dependencies": {
    "nuxt": "^4.5.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1"
  }
}
