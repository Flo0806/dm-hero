{
  "name": "@dm-hero/app",
  "version": "1.3.2",
  "description": "A personal D&D campaign management tool for Dungeon Masters with fuzzy search, entity management, and session tracking",
  "author": "Florian Heuberger",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Flo0806/dm-hero.git"
  },
  "bugs": {
    "url": "https://github.com/Flo0806/dm-hero/issues"
  },
  "homepage": "https://github.com/Flo0806/dm-hero#readme",
  "keywords": [
    "dnd",
    "dungeons-and-dragons",
    "campaign-management",
    "dungeon-master",
    "dm-tools",
    "rpg",
    "ttrpg",
    "nuxt",
    "vue",
    "vuetify",
    "sqlite",
    "fuzzy-search",
    "entity-management"
  ],
  "main": "electron/main.js",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:electron": "concurrently \"nuxt dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron . --ozone-platform=x11 --no-sandbox\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && pnpm rebuild better-sqlite3",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "node scripts/test-data/reset-and-seed.js",
    "electron:rebuild": "node scripts/electron-rebuild.js",
    "electron:rebuild:linux": "cd $(find node_modules/.pnpm -type d -name 'better-sqlite3' -path '*/node_modules/better-sqlite3' | head -1) && HOME=~/.electron-gyp npx node-gyp rebuild --target=39.2.3 --arch=x64 --dist-url=https://electronjs.org/headers",
    "electron:start": "cross-env NODE_ENV=production electron . --ozone-platform=x11 --no-sandbox",
    "electron:build": "nuxt build && pnpm electron:rebuild && electron-builder --linux",
    "electron:build:win": "nuxt build && pnpm electron:rebuild && electron-builder --win",
    "mode:web": "pnpm rebuild better-sqlite3 && echo '✅ Switched to Web Mode (pnpm dev)'",
    "mode:electron": "pnpm electron:rebuild:linux && echo '✅ Switched to Electron Mode (pnpm electron:start)'"
  },
  "build": {
    "appId": "com.dm-hero.app",
    "productName": "DM Hero",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/icons"
    },
    "files": [
      "electron/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/icons/icon-256.png",
        "to": "icon-256.png"
      },
      {
        "from": ".output",
        "to": ".output",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": ".output/server/node_modules/better-sqlite3",
        "filter": [
          "**/*",
          "!build/Release/obj.target/**",
          "!prebuilds/**",
          "!src/**",
          "!deps/**"
        ]
      },
      {
        "from": "node_modules/bindings",
        "to": ".output/server/node_modules/bindings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": ".output/server/node_modules/file-uri-to-path",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "DM-Hero-${version}-win.${ext}"
    },
    "nsis": {
      "artifactName": "DM-Hero-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "electron/icons/icon.png",
      "artifactName": "DM-Hero-${version}.${ext}",
      "executableName": "dm-hero"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "electron/icons/icon.icns",
      "artifactName": "DM-Hero-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "afterPack": "scripts/afterPack.cjs",
    "afterSign": "scripts/notarize.js",
    "npmRebuild": true,
    "publish": {
      "provider": "github",
      "owner": "Flo0806",
      "repo": "dm-hero"
    }
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@iconify/vue": "^5.0.1",
    "@mdi/font": "^7.4.47",
    "@nuxt/test-utils": "4.0.3",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.10.0",
    "bindings": "^1.5.0",
    "electron-updater": "^6.8.3",
    "fastest-levenshtein": "^1.0.16",
    "file-uri-to-path": "^2.0.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.4",
    "md-editor-v3": "^6.5.1",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "unzipper": "^0.12.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.35",
    "vue-pdf-embed": "^2.1.4",
    "vue-router": "^5.0.7",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.12.6"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.4",
    "@nuxt/eslint": "1.10.0",
    "@oxc-minify/binding-linux-x64-gnu": "^0.133.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.133.0",
    "@oxc-resolver/binding-linux-x64-gnu": "^11.19.1",
    "@oxc-transform/binding-linux-x64-gnu": "^0.133.0",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "png2icons": "^2.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  }
}
